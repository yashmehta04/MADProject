<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Storage permissions -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPlayer">

        <!-- Splash Activity (Launcher) -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MusicPlayer.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main Activity -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Glassmorphism Test Activity -->
        <activity
            android:name=".ui.GlassmorphismMainActivitySimple"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Mood Songs Activity -->
        <activity
            android:name=".ui.MoodSongsActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Now Playing Activity -->
        <activity
            android:name=".ui.GlassmorphismNowPlayingActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Media3 Playback Service -->
        <service
            android:name=".services.PlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- New Song Detection Service -->
        <service
            android:name=".services.NewSongDetectionService"
            android:exported="false"
            android:enabled="true" />

        <!-- Queue Manager Activity -->
        <activity
            android:name=".activities.QueueActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Equalizer Activity -->
        <activity
            android:name=".activities.EqualizerActivity"
            android:exported="false"
            android:theme="@style/Theme.MusicPlayer" />

        <!-- Home Screen Widget -->
        <receiver
            android:name=".widgets.PlayerWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/player_widget_info" />
        </receiver>

    </application>

</manifest>