<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Glassmorphism Base Theme -->
    <style name="GlassmorphismTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/glass_primary</item>
        <item name="colorPrimaryVariant">@color/glass_primary_variant</item>
        <item name="colorSecondary">@color/glass_accent</item>
        <item name="colorSecondaryVariant">@color/glass_accent_variant</item>
        <item name="android:colorBackground">@color/glass_background</item>
        <item name="colorSurface">@color/glass_surface</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorOnBackground">@color/glass_text_primary</item>
        <item name="colorOnSurface">@color/glass_text_secondary</item>
        
        <!-- Glassmorphism specific -->
        <item name="android:windowBackground">@color/glass_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Remove elevation shadows -->
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Glass Card Styles -->
    <style name="GlassCard" parent="">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:elevation">0dp</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- Glass Button Styles -->
    <style name="GlassButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/bg_glass_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">0dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/glass_ripple</item>
    </style>

    <!-- Glass Text Styles -->
    <style name="GlassTextHeadline" parent="">
        <item name="android:textColor">@color/glass_text_primary</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="GlassTextSubtitle" parent="">
        <item name="android:textColor">@color/glass_text_secondary</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="GlassTextBody" parent="">
        <item name="android:textColor">@color/glass_text_tertiary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Immersive Scroll View -->
    <style name="ImmersiveScrollView" parent="">
        <item name="android:scrollbars">none</item>
        <item name="android:overScrollMode">never</item>
        <item name="android:clipToPadding">false</item>
        <item name="android:clipChildren">false</item>
    </style>
</resources>
